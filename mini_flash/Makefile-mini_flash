# -*- makefile-gmake -*-

# include link object list
include ../core/corelinkobjs.mak
include ../moments/momentslinkobjs.mak
include ../pkpm/pkpmlinkobjs.mak
include ../vlasov/vlasovlinkobjs.mak
include ../mini_flash/mini_flashlinkobjs.mak
PKPM_INCS = -I../pkpm/$(KERNELS_DIR)/pkpm -I../pkpm/zero

SRC_DIRS := $(KERNELS_DIR) zero apps
UNIT_DIRS := unit

PREFIX ?= ${HOME}/gkylsoft
SUPERLU_INC = $(PREFIX)/superlu/include
ifeq ($(UNAME_S),Linux)
	SUPERLU_LIB_DIR = $(PREFIX)/superlu/lib64
	SUPERLU_LIB = $(PREFIX)/superlu/lib64/libsuperlu.a
else
	SUPERLU_LIB_DIR = $(PREFIX)/superlu/lib
	SUPERLU_LIB = $(PREFIX)/superlu/lib/libsuperlu.a
endif

LLIB := ../$(BUILD_DIR)/mini_flash/libg0mini_flash.so
SLLIB := 
SRCS := $(shell find $(SRC_DIRS) -name *.c)
ifdef USING_NVCC
	SRCS += $(shell find $(SRC_DIRS) -name *.cu)
	SRCS += $(shell find $(UNIT_DIRS) -name *.cu)
endif
OBJS := $(SRCS:%=../$(BUILD_DIR)/mini_flash/%.o)
DEPS := $(OBJS:.o=.d)

UNITS := $(patsubst %.c,../${BUILD_DIR}/mini_flash/%,$(wildcard unit/ctest_*.c))
MPI_UNITS := $(patsubst %.c,../${BUILD_DIR}/mini_flash/%,$(wildcard unit/mctest_*.c))
LUA_UNITS := $(patsubst %.c,../${BUILD_DIR}/mini_flash/%,$(wildcard unit/lctest_*.c))

REGS := $(patsubst %.c,../${BUILD_DIR}/mini_flash/%,$(wildcard creg/rt_*.c))

KERN_INC_DIRS = $(shell find $(KERNELS_DIR) -type d)
KERN_INCLUDES = $(addprefix -I,$(KERN_INC_DIRS))
EXT_INCS := -I${MPI_INC_DIR} -I${NCCL_INC_DIR} -I${CUDSS_INC_DIR} -I${LUA_INC_DIR} -I${LAPACK_INC} -I${SUPERLU_INC}
INCS := ${EXT_INCS} ${CORE_INCS} ${MOMENTS_INCS} ${VLASOV_INCS} ${PKPM_INCS} -I$(KERNELS_DIR) -Izero -Iapps -Icreg $(KERN_INCLUDES)

CORE_LIB_DIR := -L../${BUILD_DIR}/core
CORE_LIB := -lg0core

EXEC_LIB_DIRS = -L${SUPERLU_LIB_DIR} -L${MPI_LIB_DIR} -L${NCCL_LIB_DIR} -L${CUDSS_LIB_DIR} -L${LUA_LIB_DIR}
EXEC_EXT_LIBS = -lsuperlu ${LAPACK_LIB} ${CUDA_LIBS} ${MPI_RPATH} ${MPI_LIBS} ${NCCL_LIBS} ${CUDSS_RPATH} ${CUDSS_LIBS} ${LUA_RPATH} ${LUA_LIBS} -lm -lpthread -ldl
EXEC_LIBS = -L../${BUILD_DIR}/mini_flash ${LLIB} ${SLLIB} ${EXEC_EXT_LIBS}

LDFLAGS += -Wl,-rpath,./${BUILD_DIR}/core
LDFLAGS += -Wl,-rpath,./${BUILD_DIR}/moments
LDFLAGS += -Wl,-rpath,./${BUILD_DIR}/pkpm
LDFLAGS += -Wl,-rpath,./${BUILD_DIR}/mini_flash

LDFLAGS += -Wl,-rpath,../${BUILD_DIR}/core
LDFLAGS += -Wl,-rpath,../${BUILD_DIR}/moments
LDFLAGS += -Wl,-rpath,../${BUILD_DIR}/plpm
LDFLAGS += -Wl,-rpath,../${BUILD_DIR}/mini_flash

unit: ${LLIB} ${SLLIB} $(UNITS) ${MPI_UNITS} ## Build unit tests
regression: ${LLIB} ${SLLIB} ${REGS} creg/rt_arg_parse.h ## Build regression tests

.PHONY: all
all: $(LLIB) $(SLLIB) ## Build all targets
.DEFAULT_GOAL := all

# c -> o files
../$(BUILD_DIR)/mini_flash/%.c.o: %.c
	$(MKDIR_P) $(dir $@)
	$(CC) -c $(CFLAGS) $(ARCH_FLAGS) $(INCS) $< -o $@

# Build commands for CUDA source                                                                                                                                                     
../$(BUILD_DIR)/mini_flash/%.cu.o: %.cu
	$(MKDIR_P) $(dir $@)
	$(CC) -c $(CFLAGS) $(NVCC_FLAGS) $(INCS) $< -o $@

# Unit tests
$(UNITS): ../${BUILD_DIR}/mini_flash/unit/%: unit/%.c $(LLIB) $(SLLIB)
	$(MKDIR_P) ../${BUILD_DIR}/mini_flash/unit
	${CC} ${CFLAGS} ${LDFLAGS} -o $@ $< -I. $(INCS) ${EXEC_LIB_DIRS} ${EXEC_LIBS}

# MPI unit tests
$(MPI_UNITS): ../${BUILD_DIR}/mini_flash/unit/%: unit/%.c $(LLIB) $(SLLIB)
	$(MKDIR_P) ../${BUILD_DIR}/mini_flash/unit
	${CC} ${CFLAGS} ${LDFLAGS} -o $@ $< -I. $(INCS) ${EXEC_LIB_DIRS} ${EXEC_LIBS}

# Regression tests
$(REGS): ../${BUILD_DIR}/mini_flash/creg/%: creg/%.c $(LLIB) $(SLLIB)
	$(MKDIR_P) ../${BUILD_DIR}/mini_flash/creg
	${CC} ${CFLAGS} ${LDFLAGS} -o $@ $< -I. $(INCS) ${EXEC_LIB_DIRS} ${EXEC_LIBS}

ifdef USING_NVCC
../$(BUILD_DIR)/mini_flash/$(KERNELS_DIR)/mini_flash/%.c.o : $(KERNELS_DIR)/mini_flash/%.c
	$(MKDIR_P) $(dir $@)
	$(CC) $(CFLAGS) $(NVCC_FLAGS) $(INCS) -c $< -o $@
endif

# build lib
$(LLIB): $(OBJS) ../$(BUILD_DIR)/gyrokinetic/libg0gyrokinetic.so
	$(MKDIR_P) $(dir $@)

ifeq ($(UNAME),Linux)
ifdef USING_NVCC
	$(CC) -shared -o $@ ${CORE_LINK_OBJS} ${MOMENTS_LINK_OBJS} ${VLASOV_LINK_OBJS} ${PKPM_LINK_OBJS} ${mini_flash_LINK_OBJS} ${mini_flash_LINK_CU_OBJS} -Xlinker=-soname -Xlinker=libg0mini_flash.so -L${SUPERLU_LIB_DIR} -L${MPI_LIB_DIR} -L${NCCL_LIB_DIR} -L${CUDSS_LIB_DIR} -L${LUA_LIB_DIR} -L${LAPACK_LIB_DIR} -lsuperlu ${LAPACK_LIB} ${CUDA_LIBS} ${MPI_RPATH} ${MPI_LIBS} ${NCCL_LIBS} ${CUDSS_RPATH} ${CUDSS_LIBS} ${LUA_RPATH} ${LUA_LIBS} -lm -lpthread -ldl -arch=sm_${CUDA_ARCH} -rdc=true --compiler-options="-fPIC"
else
## Darwin
	$(CC) -shared -o $@ ${CORE_LINK_OBJS} ${MOMENTS_LINK_OBJS} ${VLASOV_LINK_OBJS} ${PKPM_LINK_OBJS} ${mini_flash_LINK_OBJS}  -Wl,-soname,libg0mini_flash.so -L${SUPERLU_LIB_DIR} -L${MPI_LIB_DIR} -L${NCCL_LIB_DIR} -L${CUDSS_LIB_DIR} -L${LUA_LIB_DIR} -L${LAPACK_LIB_DIR} -lsuperlu ${LAPACK_LIB} ${CUDA_LIBS} ${MPI_RPATH} ${MPI_LIBS} ${NCCL_LIBS} ${CUDSS_RPATH} ${CUDSS_LIBS} ${LUA_RPATH} ${LUA_LIBS} -lm -lpthread -ldl
endif
else
	$(CC) -shared -o $@ ${CORE_LINK_OBJS} ${MOMENTS_LINK_OBJS} ${VLASOV_LINK_OBJS} ${PKPM_LINK_OBJS} ${mini_flash_LINK_OBJS} -Wl,-install_name,@rpath/libg0mini_flash.so -L${SUPERLU_LIB_DIR} -L${MPI_LIB_DIR} -L${NCCL_LIB_DIR} -L${CUDSS_LIB_DIR} -L${LUA_LIB_DIR} -L${LAPACK_LIB_DIR} -lsuperlu ${LAPACK_LIB} ${CUDA_LIBS} ${MPI_RPATH} ${MPI_LIBS} ${NCCL_LIBS} ${CUDSS_RPATH} ${CUDSS_LIBS} ${LUA_RPATH} ${LUA_LIBS} -lm -lpthread -ldl
endif

.PHONY: check valcheck
# Run all unit tests
check: unit ## Build (if needed) and run all unit tests
	$(foreach unit,${UNITS},echo $(unit); $(unit) -E;)

valcheck: unit ## Run valgrind on unit test
	$(foreach unit,$(UNITS),valgrind --leak-check=full --show-leak-kinds=all --track-origins=yes --show-error-list=yes $(unit) --exec=never 2>$(unit)_val_err 1>/dev/null;)
	$(foreach unit,$(UNITS),../core/minus/checkval.sh $(unit);)

-include $(DEPS)

# Headers to install
INSTALL_HEADERS := $(shell ls $(KERNELS_DIR)/*/gkyl_*.h apps/gkyl_*.h zero/gkyl_*.h | grep -v "priv" | sort)

.PHONY: install
install: all
# Construct install 
	$(MKDIR_P) ${INSTALL_PREFIX}/${PROJ_NAME}/include
	${MKDIR_P} ${INSTALL_PREFIX}/${PROJ_NAME}/lib
	${MKDIR_P} ${INSTALL_PREFIX}/${PROJ_NAME}/bin
	${MKDIR_P} ${INSTALL_PREFIX}/${PROJ_NAME}/share
# Headers
	cp ${INSTALL_HEADERS} ${INSTALL_PREFIX}/${PROJ_NAME}/include
# libraries
	cp -f $(LLIB) ${INSTALL_PREFIX}/${PROJ_NAME}/lib/libg0mini_flash.so

.PHONY: clean
clean: ## Clean build output
	rm -rf ../${BUILD_DIR}/mini_flash
